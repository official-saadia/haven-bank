        <mxCell id="pg" value="Postgres" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#6E6E6E;fontColor=#111111;fontSize=12;" vertex="1" parent="1">
