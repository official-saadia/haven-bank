<mxfile host="app.diagrams.net">
  <diagram name="Architecture" id="haven-arch">
    <mxGraphModel dx="1200" dy="820" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="backend" value="Backend (Spring Boot)" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;fontColor=#FFFFFF;fontStyle=1;fontSize=16;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="60" width="420" height="560" as="geometry" />
        </mxCell>

        <mxCell id="authsrv" value="Authorization Server&#10;Spring Authorization Server&#10;OAuth 2.1 / OIDC / JWT" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#111111;fontSize=13;" vertex="1" parent="backend">
          <mxGeometry x="40" y="70" width="340" height="100" as="geometry" />
        </mxCell>

        <mxCell id="restapi" value="REST API&#10;accounts, transfers, history" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#111111;fontSize=13;" vertex="1" parent="backend">
          <mxGeometry x="40" y="230" width="340" height="90" as="geometry" />
        </mxCell>

        <mxCell id="notif" value="Notifications&#10;event-driven, channel-agnostic" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#111111;fontSize=13;" vertex="1" parent="backend">
