        <mxCell id="e1" value="login (OAuth 2.1 / OIDC + PKCE)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=none;strokeColor=#999999;fontColor=#999999;fontSize=11;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="browser" target="authsrv">
