# Authorization server (same application as the API)
VITE_OIDC_AUTHORITY=http://localhost:8080
VITE_OIDC_CLIENT_ID=spa
VITE_OIDC_REDIRECT_URI=http://localhost:5173/oauth/callback
VITE_OIDC_POST_LOGOUT_URI=http://localhost:5173/
VITE_OIDC_SCOPE=openid profile accounts.read transfers.write

# Resource server (REST API)
VITE_API_BASE=http://localhost:8080
